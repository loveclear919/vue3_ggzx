# 各环境的共享配置模板。Vite 按启动模式自动加载同名文件：
#   pnpm dev        → .env.development
#   pnpm build:prod → .env.production
#   pnpm build:test → .env.test
# 个人本地覆盖请用 .env.development.local 等（已被 gitignore 忽略）

# API 基础路径（不同环境建议不同前缀，便于网关区分）
#   开发：/api       （Vite 代理到 http://localhost:3000，见 vite.config.ts 的 server.proxy）
#   生产：/prod-api
#   测试：/test-api
VITE_APP_BASE_API=/api

# 站点标题（index.html 通过 %VITE_APP_TITLE% 引用）
VITE_APP_TITLE=硅谷甄选运营平台