{
  "name": "ggzx",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:frontend": "pnpm --filter vue-project run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "prepare": "husky",
    "check": "pnpm --filter vue-project run type-check && pnpm --filter backend run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0"
  }
}
