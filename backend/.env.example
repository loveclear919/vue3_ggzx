# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 用法：cp .env.example .env

# 服务监听端口（不填则默认 3000）
PORT=3000

# MongoDB 连接串
# 本地示例：mongodb://127.0.0.1:27017/your-db-name
MONGODB_URI=mongodb://127.0.0.1:27017/your-db-name

# JWT 签名密钥（生产环境务必使用随机值，且不能提交到仓库）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret
