{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "prettier --write src/ scripts/",
    "seed": "tsx scripts/seed-categories.ts && tsx scripts/seed-base-sale-attr.ts && tsx scripts/seed-attrs.ts && tsx scripts/seed-permissions.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:permissions": "tsx scripts/seed-permissions.ts",
    "sync:indexes": "tsx scripts/sync-indexes.ts",
    "test:boundary": "tsx scripts/boundary-test.ts",
    "clean:residue": "tsx scripts/clean-test-residue.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "type-check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "audit:data": "tsx scripts/audit-data.ts",
    "seed:attrs": "tsx scripts/seed-attrs.ts",
    "seed:spus": "tsx scripts/seed-spus.ts",
    "seed:skus": "tsx scripts/seed-skus.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "prettier": "3.9.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
